<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fianzahealth</groupId>
        <artifactId>ras-common</artifactId>
        <version>1.7-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.fianzahealth.ras</groupId>
    <artifactId>ras-backend</artifactId>
    <version>1.8-SNAPSHOT</version>
    <name>ras-backend</name>
    <description>Aggregator that runs ras-api + reconer + x12er + ras-analyzer in a
        single Spring Boot process. Each peer module is consumed as a library jar.
        Controllers are re-prefixed at runtime via PathMatchConfigurer so the existing
        context-paths (/ras-api, /reconer, /x12er, /ras-analyzer) still route correctly.
        In bundled mode, in-process clients dispatch ras-api -> peer calls through
        the local DispatcherServlet instead of HTTP, and RasBackendExternalRequestFilter
        blocks external HTTP access to peer paths.</description>

    <profiles>
        <profile>
            <id>github</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
                <repository>
                    <!-- Cross-repo read of menacher/* packages (ras-api, reconer,
                         x12er, ras-analyzer, ras-common, ras-tenant, ras-jooq).
                         Matches the `github-read` <server> entry in the workflow's
                         settings.xml — must NOT be `github`, which would have no
                         matching credential entry and 401. -->
                    <id>github-read</id>
                    <name>GitHub Packages (cross-repo read)</name>
                    <url>https://maven.pkg.github.com/menacher/*</url>
                    <snapshots><enabled>true</enabled></snapshots>
                    <releases><enabled>true</enabled></releases>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <dependencies>
        <!-- Library jars of each peer service (no classifier == library variant). -->
        <dependency>
            <groupId>com.fianzahealth</groupId>
            <artifactId>ras-api</artifactId>
            <version>1.8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.fianzahealth.ras</groupId>
            <artifactId>reconer</artifactId>
            <version>1.8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.fianzahealth</groupId>
            <artifactId>x12er</artifactId>
            <version>1.8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.medvand</groupId>
            <artifactId>ras-analyzer</artifactId>
            <version>1.8-SNAPSHOT</version>
        </dependency>

        <!-- Shared tenant infrastructure (transitively present via the peer
             jars too; declared explicitly for clarity since monolith code
             imports TenantContext / TenantHeaders directly). -->
        <dependency>
            <groupId>com.fianzahealth</groupId>
            <artifactId>ras-tenant</artifactId>
        </dependency>

        <!-- spring-test provides MockHttpServletRequest / MockHttpServletResponse used
             by AbstractInProcessClient for in-JVM dispatch through DispatcherServlet.
             Pulled into compile scope (not test) since the in-process clients are
             production code. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Override parent's classifier=boot config: ras-backend only produces
                         an executable jar (no separate library variant). -->
                    <classifier></classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
