<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fianzahealth</groupId>
        <artifactId>ras-common</artifactId>
        <version>1.8-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.fianzahealth.ras</groupId>
    <artifactId>ras-backend</artifactId>
    <version>1.8-SNAPSHOT</version>
    <name>ras-backend</name>
    <description>Aggregator that runs ras-api + reconer + x12er + ras-analyzer in a
        single Spring Boot process. Each peer module is consumed as a library jar.
        Controllers are re-prefixed at runtime via PathMatchConfigurer so the existing
        context-paths (/ras-api, /reconer, /x12er, /ras-analyzer) still route correctly.
        In bundled mode, in-process clients dispatch ras-api -> peer calls through
        the local DispatcherServlet instead of HTTP, and RasBackendExternalRequestFilter
        blocks external HTTP access to peer paths.</description>

    <profiles>
        <profile>
            <id>github</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
                <repository>
                    <!-- Cross-repo read of menacher/* packages (ras-api, reconer,
                         x12er, ras-analyzer, ras-common, ras-tenant, ras-jooq).
                         Matches the `github-read` <server> entry in the workflow's
                         settings.xml — must NOT be `github`, which would have no
                         matching credential entry and 401. -->
                    <id>github-read</id>
                    <name>GitHub Packages (cross-repo read)</name>
                    <url>https://maven.pkg.github.com/menacher/*</url>
                    <snapshots><enabled>true</enabled></snapshots>
                    <releases><enabled>true</enabled></releases>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <dependencies>
        <!-- Library jars of each peer service (no classifier == library variant). -->
        <dependency>
            <groupId>com.fianzahealth</groupId>
            <artifactId>ras-api</artifactId>
            <version>1.8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.fianzahealth.ras</groupId>
            <artifactId>reconer</artifactId>
            <version>1.8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.fianzahealth</groupId>
            <artifactId>x12er</artifactId>
            <version>1.8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.medvand</groupId>
            <artifactId>ras-analyzer</artifactId>
            <version>1.8-SNAPSHOT</version>
        </dependency>

        <!-- Shared tenant infrastructure (transitively present via the peer
             jars too; declared explicitly for clarity since monolith code
             imports TenantContext / TenantHeaders directly). -->
        <dependency>
            <groupId>com.fianzahealth</groupId>
            <artifactId>ras-tenant</artifactId>
        </dependency>

        <!-- spring-test provides MockHttpServletRequest / MockHttpServletResponse used
             by AbstractInProcessClient for in-JVM dispatch through DispatcherServlet.
             Pulled into compile scope (not test) since the in-process clients are
             production code. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- The executable jar is target/ras-backend-<version>-boot.jar, the parent's
                     convention (plain jar = library, -boot = executable). The Dockerfile globs
                     for *-boot.jar; keep the two in step.

                     This used to override the inherited classifier with an empty
                     <classifier></classifier> on the theory that ras-backend needs no library
                     variant. That override is Maven-version dependent and silently shipped a
                     broken image: Maven 4 reads the empty element as "" and honours it, so the
                     fat jar replaced the plain jar in place; Maven 3.9 (what ubuntu-latest runs)
                     reads it as absent and inherits classifier=boot, leaving the plain jar THIN.
                     The Dockerfile's old target/ras-backend-*.jar then matched both files and
                     BuildKit took the thin one (last in sort order, '-' 0x2D < '.' 0x2E), so CI
                     pushed a 28 KB jar with no Main-Class that died on startup, while the same
                     command on a Maven 4 dev box produced a correct image. Inheriting the
                     classifier is deterministic across both majors; the unused thin jar is the
                     price, and it is cheaper than a build that only breaks in CI.

                     id=repackage merges with the execution spring-boot-starter-parent already
                     declares under that id. Leaving it unset made a SECOND execution ("default"),
                     so repackage ran twice per build. -->
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>build-info</goal>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
